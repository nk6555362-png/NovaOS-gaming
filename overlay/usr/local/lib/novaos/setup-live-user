#!/usr/bin/env bash
set -Eeuo pipefail

if ! id nova-live >/dev/null 2>&1; then
  supplementary_groups=()
  for group in wheel audio video storage optical; do
    if getent group "$group" >/dev/null 2>&1; then
      supplementary_groups+=("$group")
    fi
  done

  if ((${#supplementary_groups[@]} > 0)); then
    group_list=$(IFS=,; printf '%s' "${supplementary_groups[*]}")
    useradd --create-home --shell /bin/bash --groups "$group_list" nova-live
  else
    useradd --create-home --shell /bin/bash nova-live
  fi
fi

install -d -o root -g root -m 0755 /etc/sudoers.d
printf '%s\n' 'nova-live ALL=(root) NOPASSWD: /usr/bin/calamares' > /etc/sudoers.d/90-nova-live-calamares
chmod 0440 /etc/sudoers.d/90-nova-live-calamares
visudo -cf /etc/sudoers.d/90-nova-live-calamares
