#!/usr/bin/env bash
set -Eeuo pipefail

if ! id nova-live >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash --groups wheel,audio,video,storage,optical nova-live
fi

install -d -o root -g root -m 0755 /etc/sudoers.d
printf '%s\n' 'nova-live ALL=(root) NOPASSWD: /usr/bin/calamares' > /etc/sudoers.d/90-nova-live-calamares
chmod 0440 /etc/sudoers.d/90-nova-live-calamares
visudo -cf /etc/sudoers.d/90-nova-live-calamares
